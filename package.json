{
  "name": "synsa",
  "version": "0.1.0",
  "description": "SYNSA — local Twitch stream toolkit: alert overlays, chat dashboard, now-playing and countdown modules for OBS.",
  "main": "electron/main.js",
  "scripts": {
    "start": "node server.js",
    "electron": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "express": "^5.2.1",
    "socket.io-client": "^4.8.3",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "electron-reload": "^2.0.0-alpha.1"
  },
  "build": {
    "appId": "com.synsa.app",
    "productName": "SYNSA",
    "asar": true,
    "files": [
      "electron/**/*",
      "server.js",
      "twitch/**/*",
      "music/**/*",
      "update/**/*",
      "public/**/*",
      "package.json",
      "!node_modules/electron/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "electron/assets/app-icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": false,
      "createDesktopShortcut": false,
      "createStartMenuShortcut": true,
      "shortcutName": "SYNSA",
      "menuCategory": false,
      "deleteAppDataOnUninstall": false,
      "artifactName": "SYNSA Setup ${version}.exe",
      "include": "build/installer.nsh"
    },
    "publish": {
      "provider": "github",
      "owner": "SynAisa",
      "repo": "SYNSA"
    }
  },
  "allowScripts": {
    "electron@44.2.0": true
  }
}
