# Nur für den Entwicklungs-Ablauf (`npm start`) nötig.
#
# Die fertige SYNSA.exe braucht diese Datei NICHT: sie fragt die
# Twitch-Zugangsdaten beim ersten Start in der App ab und legt sie
# verschlüsselt unter %APPDATA%\SYNSA\data\config.json ab.

# Twitch app credentials — create an app at https://dev.twitch.tv/console/apps
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Must exactly match the OAuth Redirect URL registered for the app above
TWITCH_REDIRECT_URI=http://localhost:4242/auth/twitch/callback

PORT=4242
